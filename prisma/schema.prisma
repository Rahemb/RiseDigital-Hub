generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model Organization {
  id String @id @default(cuid())
  name String
  isDemo Boolean @default(false)
  email String @default("")
  phone String @default("")
  address String @default("")
  website String @default("")
  organizationNumber String @default("")
  currencyDisplay String @default("symbol")
  weekStartsOn Int @default(1)
  focusDays Int @default(7)
  users User[]
  clients Client[]
  services Service[]
  projects Project[]
  tasks Task[]
  agreements ClientService[]
  obligations PaymentObligation[]
  transactions PaymentTransaction[]
  tickets SupportTicket[]
  documents Document[]
  notes Note[]
  activities ActivityLog[]
  reminders Reminder[]
  leads Lead[]
  leadSettings LeadSettings?
  leadSources LeadSource[]
  suppressions Suppression[]
  discoveryBatch DiscoveryBatch?
  createdAt DateTime @default(now())
}
model User {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  email String @unique
  name String
  passwordHash String
  role String @default("OWNER")
  theme String @default("system")
  sessions Session[]
  tasks Task[]
  comments TaskComment[]
  createdAt DateTime @default(now())
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model LoginAttempt {
  key String @id
  count Int @default(0)
  windowStart DateTime @default(now())
}
model Client {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  companyName String
  contactPerson String
  email String
  phone String @default("")
  website String @default("")
  organizationNumber String @default("")
  address String @default("")
  status String @default("LEAD")
  tags String @default("")
  summary String @default("")
  followUpAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contacts ClientContact[]
  convertedLeads Lead[]
  projects Project[]
  tasks Task[]
  agreements ClientService[]
  obligations PaymentObligation[]
  tickets SupportTicket[]
  documents Document[]
  notes Note[]
  activities ActivityLog[]
  reminders Reminder[]
  @@index([organizationId,status])
  @@index([organizationId,companyName])
}
model Lead {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  sourceId String
  source LeadSource @relation(fields:[sourceId],references:[id],onDelete:Restrict)
  companyName String
  orgNumber String
  industry String @default("")
  industryCode String @default("")
  municipality String @default("")
  municipalityCode String @default("")
  registryVerified Boolean @default(false)
  registryActive Boolean?
  website String @default("")
  websiteSource String @default("")
  websiteStatus String @default("UNKNOWN")
  websiteVerifiedAt DateTime?
  email String @default("")
  emailSource String @default("")
  emailStatus String @default("UNVERIFIED")
  emailKind String @default("UNKNOWN")
  qualification String @default("NEW")
  contactStatus String @default("NOT_CONTACTED")
  notes String @default("")
  tags String @default("")
  score Int?
  scoreAssessment String @default("INSUFFICIENT")
  discoveredAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviewedAt DateTime?
  followUpAt DateTime?
  approvedAt DateTime?
  complianceNotes String @default("")
  clientId String?
  client Client? @relation(fields:[clientId],references:[id],onDelete:Restrict)
  scanUntil DateTime?
  audits WebsiteAudit[]
  scores LeadScore[]
  drafts OutreachDraft[]
  activities OutreachActivity[]
  discovery WebsiteDiscovery?
  review LeadReview?
  savedState SavedLeadState?
  discoveryItems DiscoveryItem[]
  @@unique([organizationId,orgNumber])
  @@index([organizationId,contactStatus,followUpAt])
  @@index([organizationId,qualification,score])
}
model LeadReview {
  leadId String @id
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  phone String @default("")
  websiteQuality String @default("")
  googleObservations String @default("")
  opportunities String @default("")
  relevantServices String @default("")
}
model SavedLeadState {
  leadId String @id
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  removedAt DateTime?
}
model WebsiteDiscovery {
  leadId String @id
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  status String
  candidates String
  sources String
  explanation String
  selectedUrl String @default("")
  startingWebsite String @default("")
  checkedAt DateTime @default(now())
  confirmedAt DateTime?
  @@index([status,checkedAt])
}
model DiscoveryBatch {
  id String @id @default(cuid())
  organizationId String @unique
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  status String @default("RUNNING")
  analyze Boolean @default(false)
  leaseUntil DateTime?
  leaseToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items DiscoveryItem[]
}
model DiscoveryItem {
  id String @id @default(cuid())
  batchId String
  batch DiscoveryBatch @relation(fields:[batchId],references:[id],onDelete:Cascade)
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  state String @default("QUEUED")
  outcome String @default("")
  error String @default("")
  completedAt DateTime?
  @@unique([batchId,leadId])
  @@index([batchId,state])
}
model LeadSource {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  kind String
  name String
  url String
  createdAt DateTime @default(now())
  leads Lead[]
  @@unique([organizationId,kind])
}
model WebsiteAudit {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  url String
  status String
  httpStatus Int?
  findings String
  error String @default("")
  createdAt DateTime @default(now())
  @@index([leadId,createdAt])
}
model LeadScore {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  value Int?
  assessment String
  reasons String
  rules String
  createdAt DateTime @default(now())
  @@index([leadId,createdAt])
}
model OutreachDraft {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  template String
  subject String
  body String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@index([leadId,updatedAt])
}
model OutreachActivity {
  id String @id @default(cuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  kind String
  body String
  createdAt DateTime @default(now())
  @@index([leadId,createdAt])
}
model Suppression {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  key String
  reason String
  createdAt DateTime @default(now())
  @@unique([organizationId,key])
}
model LeadSettings {
  organizationId String @id
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  config String
  requestAfter DateTime?
  updatedAt DateTime @updatedAt
}
model ClientContact {
  id String @id @default(cuid())
  clientId String
  client Client @relation(fields:[clientId],references:[id],onDelete:Cascade)
  name String
  email String
  phone String?
}
model Service {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  name String
  description String @default("")
  category String
  defaultPriceOre Int?
  billingType String @default("MONTHLY")
  active Boolean @default(true)
  agreements ClientService[]
  @@index([organizationId])
}
model ClientService {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  clientId String
  client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
  serviceId String
  service Service @relation(fields:[serviceId],references:[id],onDelete:Restrict)
  priceOre Int
  intervalMonths Int?
  intervalDays Int?
  billingAnchorDate DateTime?
  startDate DateTime
  endDate DateTime?
  nextPaymentDate DateTime?
  notes String @default("")
  active Boolean @default(true)
  obligations PaymentObligation[]
  @@index([organizationId,clientId])
}
model Project {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  clientId String
  client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
  name String
  description String @default("")
  type String @default("WEBSITE")
  status String @default("PLANNED")
  priority String @default("MEDIUM")
  archived Boolean @default(false)
  startDate DateTime?
  deadline DateTime?
  createdAt DateTime @default(now())
  tasks Task[]
  tickets SupportTicket[]
  documents Document[]
  notes Note[]
  @@index([organizationId,status])
}
model Task {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  clientId String
  client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
  projectId String?
  project Project? @relation(fields:[projectId],references:[id],onDelete:Restrict)
  assigneeId String?
  assignee User? @relation(fields:[assigneeId],references:[id],onDelete:SetNull)
  title String
  description String @default("")
  priority String @default("MEDIUM")
  status String @default("TODO")
  dueDate DateTime?
  completedAt DateTime?
  archived Boolean @default(false)
  comments TaskComment[]
  createdAt DateTime @default(now())
  @@index([organizationId,status,dueDate])
}
model TaskComment {
  id String @id @default(cuid())
  taskId String
  task Task @relation(fields:[taskId],references:[id],onDelete:Cascade)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  body String
  createdAt DateTime @default(now())
}
model PaymentObligation {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  clientId String
  client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
  agreementId String?
  agreement ClientService? @relation(fields:[agreementId],references:[id],onDelete:Restrict)
  periodKey String?
  amountOre Int
  dueDate DateTime
  cancelled Boolean @default(false)
  reference String @default("")
  notes String @default("")
  transactions PaymentTransaction[]
  @@unique([agreementId,periodKey])
  @@index([organizationId,dueDate])
}
model PaymentTransaction {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  obligationId String
  obligation PaymentObligation @relation(fields:[obligationId],references:[id],onDelete:Restrict)
  amountOre Int
  paidAt DateTime
  method String
  reference String @default("")
  notes String @default("")
  createdAt DateTime @default(now())
  @@index([organizationId,paidAt])
}
model SupportTicket {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  clientId String
  client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
  projectId String?
  project Project? @relation(fields:[projectId],references:[id],onDelete:Restrict)
  title String
  description String
  category String
  priority String @default("MEDIUM")
  status String @default("OPEN")
  internalNotes String @default("")
  createdAt DateTime @default(now())
  dueDate DateTime?
  documents Document[]
  comments TicketComment[]
  @@index([organizationId,status])
}
model Document {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  clientId String
  client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
  projectId String?
  project Project? @relation(fields:[projectId],references:[id],onDelete:Restrict)
  ticketId String?
  ticket SupportTicket? @relation(fields:[ticketId],references:[id],onDelete:Restrict)
  originalName String
  storageKey String @unique
  mimeType String
  sizeBytes Int
  createdAt DateTime @default(now())
  deletedAt DateTime?
  @@index([organizationId,clientId])
}
model Note {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  clientId String
  client Client @relation(fields:[clientId],references:[id],onDelete:Cascade)
  projectId String?
  project Project? @relation(fields:[projectId],references:[id],onDelete:Cascade)
  body String
  createdAt DateTime @default(now())
  @@index([organizationId,clientId])
}
model ActivityLog {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  clientId String?
  client Client? @relation(fields:[clientId],references:[id],onDelete:SetNull)
  message String
  entityType String?
  entityId String?
  createdAt DateTime @default(now())
  @@index([organizationId,createdAt])
}
model TicketComment {
  id String @id @default(cuid())
  ticketId String
  ticket SupportTicket @relation(fields:[ticketId],references:[id],onDelete:Cascade)
  authorName String
  body String
  createdAt DateTime @default(now())
  @@index([ticketId,createdAt])
}
model Reminder {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  clientId String
  client Client @relation(fields:[clientId],references:[id],onDelete:Restrict)
  title String
  dueDate DateTime
  completedAt DateTime?
  @@index([organizationId,dueDate])
}
